rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // 1. Global safety net (Default deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Base Helpers
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // 3. Entity Validations
    function isValidUser(data) {
      return data.keys().hasAll(['id', 'name', 'email', 'role', 'created_at'])
        && data.keys().size() <= 6
        && data.id is string && data.id.size() <= 128
        && data.name is string && data.name.size() > 0 && data.name.size() <= 100
        && data.email is string && data.email.size() <= 150
        && data.role in ['client', 'model']
        && (data.avatar == null || (data.avatar is string && data.avatar.size() <= 500));
    }

    function isValidModel(data) {
      return data.keys().hasAll(['id', 'user_id', 'bio', 'gender', 'age', 'height', 'location', 'daily_rate', 'experience_level', 'created_at'])
        && data.keys().size() == 10
        && data.id is string && data.id.size() <= 128
        && data.user_id is string && data.user_id.size() <= 128
        && data.bio is string && data.bio.size() <= 2000
        && data.gender in ['Female', 'Male', 'Non-binary', 'Other']
        && data.age is int && data.age >= 16 && data.age <= 120
        && data.height is int && data.height >= 50 && data.height <= 300
        && data.location is string && data.location.size() <= 200
        && data.daily_rate is int && data.daily_rate >= 0 && data.daily_rate <= 100000
        && data.experience_level in ['New Face', 'Rising Star', 'Professional', 'Top Model'];
    }

    function isValidPortfolioImage(data) {
      return data.keys().hasAll(['id', 'model_id', 'image_url', 'created_at'])
        && data.keys().size() == 4
        && data.id is string && data.id.size() <= 128
        && data.model_id is string && data.model_id.size() <= 128
        && data.image_url is string && data.image_url.size() <= 1000;
    }

    function isValidBooking(data) {
      return data.keys().hasAll(['id', 'client_id', 'model_id', 'booking_date', 'event_name', 'event_location', 'status', 'created_at'])
        && data.keys().size() <= 9
        && data.id is string && data.id.size() <= 128
        && data.client_id is string && data.client_id.size() <= 128
        && data.model_id is string && data.model_id.size() <= 128
        && data.booking_date is string && data.booking_date.size() <= 30
        && data.event_name is string && data.event_name.size() > 0 && data.event_name.size() <= 200
        && data.event_location is string && data.event_location.size() > 0 && data.event_location.size() <= 200
        && data.status in ['Pending', 'Accepted', 'Rejected']
        && (data.additional_notes == null || (data.additional_notes is string && data.additional_notes.size() <= 1000));
    }

    // 4. Match Rules

    // Users Collection
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isOwner(userId) && isValidUser(incoming());
      allow update: if isOwner(userId) && isValidUser(incoming())
        && incoming().role == existing().role; // cannot change role once registered
    }

    // Models Profile Collection
    match /models/{modelId} {
      allow read: if true; // anyone can browse or view models
      allow create: if isSignedIn() && isOwner(incoming().user_id) && isValidModel(incoming());
      allow update: if isSignedIn() && isOwner(existing().user_id) && isValidModel(incoming())
        && incoming().user_id == existing().user_id; // cannot hijack profile
    }

    // Portfolio Images
    match /portfolio_images/{imageId} {
      allow read: if true; // public portfolio visibility
      allow create: if isSignedIn() && isValidPortfolioImage(incoming()) 
        && exists(/databases/$(database)/documents/models/$(incoming().model_id))
        && get(/databases/$(database)/documents/models/$(incoming().model_id)).data.user_id == request.auth.uid;
      allow delete: if isSignedIn() && exists(/databases/$(database)/documents/models/$(existing().model_id))
        && get(/databases/$(database)/documents/models/$(existing().model_id)).data.user_id == request.auth.uid;
    }

    // Bookings
    match /bookings/{bookingId} {
      // Clients can see bookings they made; models can see bookings made for them
      allow get: if isSignedIn() && (existing().client_id == request.auth.uid || exists(/databases/$(database)/documents/models/$(existing().model_id)) && get(/databases/$(database)/documents/models/$(existing().model_id)).data.user_id == request.auth.uid);
      
      // Strict rule enforcement for listing: client queries must match clientId, models queries must match modelId
      allow list: if isSignedIn() && (resource.data.client_id == request.auth.uid || exists(/databases/$(database)/documents/models/$(resource.data.model_id)) && get(/databases/$(database)/documents/models/$(resource.data.model_id)).data.user_id == request.auth.uid);

      allow create: if isSignedIn() && isOwner(incoming().client_id) && isValidBooking(incoming())
        && incoming().status == 'Pending'; // initial request MUST be pending

      // Update bookings
      allow update: if isSignedIn() && isValidBooking(incoming()) && (
        // Client can only edit or cancel the request (before action) or cancel their own booking
        (existing().client_id == request.auth.uid && incoming().client_id == existing().client_id && incoming().model_id == existing().model_id && incoming().diff(existing()).affectedKeys().hasOnly(['event_name', 'event_location', 'booking_date', 'additional_notes', 'status'])) ||
        // Model can ONLY accept or reject the booking (update status)
        (exists(/databases/$(database)/documents/models/$(existing().model_id)) && get(/databases/$(database)/documents/models/$(existing().model_id)).data.user_id == request.auth.uid && incoming().diff(existing()).affectedKeys().hasOnly(['status']))
      );
    }
  }
}
